ARG BASE_IMAGE=ghcr.io/kgerb/forestmamba-image:3dtrees-base
FROM ${BASE_IMAGE}

ARG CHECKPOINT_URL=https://zenodo.org/api/records/16742708/files/clean_forestformer.zip/content
ARG CHECKPOINT_MEMBER=clean_forestformer/epoch_3000_fix.pth
ARG CHECKPOINT_PATH=/workspace/work_dirs/forestmamba_chm_radius16_qp300_2many_v6_expand_1/epoch_3000_fix.pth

RUN pip install --no-cache-dir \
    mamba-ssm==1.1.1 \
    causal-conv1d==1.1.1 \
    hilbertcurve==2.0.5 \
    transformers==4.36.0 \
    importlib-metadata==4.13.0 \
    wandb==0.16.6 \
    "laspy[lazrs]==2.5.4"

RUN pip uninstall -y torch-cluster torch-points-kernels \
    && FORCE_CUDA=1 pip install --no-deps --no-cache-dir torch-cluster==1.6.3 \
    && FORCE_CUDA=1 pip install --no-deps --no-cache-dir torch-points-kernels==0.7.0

RUN python -c "from pathlib import Path; from urllib.request import urlopen; Path('/tmp/forestmamba-checkpoint.zip').write_bytes(urlopen('${CHECKPOINT_URL}').read())" \
    && python -c "from pathlib import Path; from zipfile import ZipFile; checkpoint_path = Path('${CHECKPOINT_PATH}'); checkpoint_path.parent.mkdir(parents=True, exist_ok=True); checkpoint_path.write_bytes(ZipFile('/tmp/forestmamba-checkpoint.zip').read('${CHECKPOINT_MEMBER}'))" \
    && rm /tmp/forestmamba-checkpoint.zip

COPY . /workspace
RUN chmod -R a+rX /workspace

COPY replace_mmdetection_files/loops.py /opt/conda/lib/python3.10/site-packages/mmengine/runner/loops.py
COPY replace_mmdetection_files/base_model.py /opt/conda/lib/python3.10/site-packages/mmengine/model/base_model/base_model.py
COPY replace_mmdetection_files/transforms_3d.py /opt/conda/lib/python3.10/site-packages/mmdet3d/datasets/transforms/transforms_3d.py
COPY replace_mmdetection_files/distributed.py /opt/conda/lib/python3.10/site-packages/mmengine/model/wrappers/distributed.py
RUN chmod a+r \
    /opt/conda/lib/python3.10/site-packages/mmengine/runner/loops.py \
    /opt/conda/lib/python3.10/site-packages/mmengine/model/base_model/base_model.py \
    /opt/conda/lib/python3.10/site-packages/mmdet3d/datasets/transforms/transforms_3d.py \
    /opt/conda/lib/python3.10/site-packages/mmengine/model/wrappers/distributed.py

ENV PYTHONPATH=/workspace
ENV WANDB_MODE=disabled
